{
  "name": "file-harbor",
  "version": "0.1.0",
  "description": "A personal document filing cabinet",
  "main": ".vite/build/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron-rebuild -f -w better-sqlite3 && electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "pretest": "npm rebuild better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "better-sqlite3": "^12.6.0",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.38.0",
    "electron-log": "^5.4.0",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^0.501.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-pdf": "^10.3.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.0",
    "unpdf": "^0.12.0",
    "uuid": "^11.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.0",
    "@electron-forge/maker-deb": "^7.10.0",
    "@electron-forge/maker-rpm": "^7.10.0",
    "@electron-forge/maker-squirrel": "^7.10.0",
    "@electron-forge/maker-zip": "^7.10.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.0",
    "@electron-forge/plugin-fuses": "^7.10.0",
    "@electron-forge/plugin-vite": "^7.10.0",
    "@electron-forge/shared-types": "^7.10.0",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^3.7.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "drizzle-kit": "^0.30.0",
    "electron": "^35.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vitest": "^4.0.18"
  }
}
